" ────────────────────────────────────────────────────────────
"     EDITING
" ────────────────────────────────────────────────────────────

set backspace=indent,eol,start  " <BS> accross linebreaks
set wrap                        " wrap lines
set linebreak                   " break at words boundaries
set autoindent                  " keep prev line indent level
set smartindent                 " add indent after { (C/C++)
set clipboard=unnamedplus       " use system clipboard
set splitbelow splitright       " new split windows
set hidden
set confirm                     " ask for save confirmation

