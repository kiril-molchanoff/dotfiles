#!/bin/bash

cnt=0

for file in "$HOME/.vim/tags/"*
do
  proj="$(basename "$file")"    # basename
  proj="${proj//%//}"          # parameter expansion - replace % with /

  if [[ ! -d "$proj" ]]
  then
    rm -f "$file"
    echo -e "Removed: $proj"
    ((++cnt))
  fi
done

echo -e "\n$cnt tag file(s) removed."
